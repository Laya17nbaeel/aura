<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AURA Watches | Rolex Men's Watch</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Arial, sans-serif; scroll-behavior: smooth; }
        
        html, body {
            background-color: #222;
            min-height: 100vh;
            width: 100vw;
            display: flex;
            justify-content: center;
            overflow-x: hidden;
        }

        #viewport {
            position: relative;
            width: 100%; 
            background: #e0ddd6;
            transition: all 0.8s cubic-bezier(0.2, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
        }

        #viewport.phone-view {
            width: 390px;
            height: 844px;
            margin-top: 50px;
            border: 12px solid #5d4e3f;
            border-radius: 55px;
            overflow-y: auto;
            box-shadow: 0 50px 100px rgba(93, 78, 63, 0.3);
        }

        /* --- NAVIGATION --- */
        nav {
            position: fixed;
            top: 0; width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 40px;
            z-index: 1000;
            background: linear-gradient(to bottom, rgba(93, 78, 63, 0.8), transparent);
            transition: 0.4s;
        }

        .scrolled-nav {
            background: rgba(224, 221, 214, 0.95) !important;
            border-bottom: 1px solid #bfa37e;
        }

        .brand-logo-img { height: 70px; width: auto; filter: contrast(130%); cursor: pointer; }

        .nav-menu { display: flex; gap: 30px; }
        .nav-menu a {
            color: #5d4e3f !important; /* اللون القهوائي */
            text-decoration: none; text-transform: uppercase;
            font-size: 0.75rem; letter-spacing: 2px; opacity: 0.9; transition: 0.3s;
            font-weight: bold;
            cursor: pointer;
            position: relative;
            padding-bottom: 5px;
        }
        
        /* إضافة خط تحت الروابط عند التمرير - لون ذهبي */
        .nav-menu a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: #D4AF37; /* الذهبي الكلاسيكي */
            transition: width 0.3s ease;
        }
        
        .nav-menu a:hover::after {
            width: 100%;
        }
        
        .nav-menu a.active {
            border-bottom: 2px solid #D4AF37; /* الذهبي الكلاسيكي */
            opacity: 1;
        }
        
        /* تأثير لروابط التنقل عندما يكون الناف بار فاتح */
        .light-nav .nav-menu a {
            color: #5d4e3f !important;
        }
        
        .light-nav .nav-menu a::after {
            background-color: #D4AF37; /* الذهبي الكلاسيكي */
        }
        
        .light-nav .nav-menu a.active {
            border-bottom-color: #D4AF37; /* الذهبي الكلاسيكي */
        }

        .nav-actions { display: flex; gap: 20px; align-items: center; }
        .icon-btn { background: none; border: none; cursor: pointer; transition: 0.3s; }
        .icon-btn img { height: 20px; filter: brightness(0) invert(1); opacity: 0.8; }
        .light-nav .icon-btn img { filter: brightness(0) saturate(100%) invert(23%) sepia(8%) saturate(1732%) hue-rotate(349deg) brightness(92%) contrast(86%) !important; opacity: 0.7; }
        .icon-btn.active img { filter: drop-shadow(0 0 8px #bfa37e) brightness(0) invert(1) !important; opacity: 1; }

        /* --- PRODUCT SECTION --- */
        .product-container {
            max-width: 1200px;
            margin: 120px auto 60px;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1.2fr 1fr;
            gap: 50px;
            align-items: start;
        }

        .product-images {
            position: sticky;
            top: 120px;
        }

        .main-image {
            width: 100%;
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(93, 78, 63, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .main-image:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 40px rgba(93, 78, 63, 0.15);
        }

        .main-image img {
            width: 100%;
            height: auto;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        /* جهة المواصفات */
        .product-details {
            display: flex;
            flex-direction: column;
        }

        .brand-name {
            color: #5d4e3f;
            font-size: 1.1rem;
            letter-spacing: 3px;
            margin-bottom: 10px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .product-title {
            color: #2c241d;
            font-size: 2.8rem;
            font-weight: 300;
            margin-bottom: 15px;
            line-height: 1.1;
        }

        .product-price {
            color: #5d4e3f;
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 30px;
        }

        /* المواصفات التقنية */
        .specs-container {
            margin: 25px 0;
            background: rgba(255, 255, 255, 0.5);
            padding: 20px;
            border-radius: 10px;
            border: 1px solid rgba(191, 163, 126, 0.2);
        }

        .spec-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid rgba(93, 78, 63, 0.1);
        }

        .spec-label { font-weight: 600; color: #5d4e3f; }
        .spec-value { color: #7a6a5a; }

        .quantity-selector {
            display: flex;
            align-items: center;
            gap: 20px;
            margin: 30px 0;
        }

        .quantity-btn {
            width: 45px; height: 45px;
            border: 1.5px solid #5d4e3f;
            background: none;
            border-radius: 50%;
            font-size: 1.2rem;
            cursor: pointer;
            transition: 0.3s;
            color: #5d4e3f;
        }

        .quantity-btn:hover { 
            background: #5d4e3f; 
            color: white; 
        }

        .action-buttons {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
        }

        .add-to-cart-btn {
            flex: 2;
            padding: 20px;
            background: #5d4e3f;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .add-to-cart-btn:hover {
            background: #7a6a5a;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(93, 78, 63, 0.2);
        }

        .buy-now-btn {
            flex: 1;
            padding: 20px;
            background: #bfa37e;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .buy-now-btn:hover {
            background: #d4b794;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(191, 163, 126, 0.2);
        }

        /* --- SIDE PANELS --- */
        .side-panel {
            position: fixed; top: 0; right: -420px; width: 380px; height: 100%;
            background: rgba(191, 163, 126, 0.95); backdrop-filter: blur(20px);
            z-index: 2000; transition: 0.6s cubic-bezier(0.19, 1, 0.22, 1);
            padding: 50px 30px; color: white; border-left: 1px solid rgba(255,255,255,0.1);
        }
        .side-panel.open { right: 0; }
        .panel-header { font-size: 1.5rem; color: #5d4e3f; margin-bottom: 30px; letter-spacing: 2px; border-bottom: 1px solid rgba(93, 78, 63, 0.3); padding-bottom: 10px; display: flex; justify-content: space-between; }
        
        .cart-items {
            margin-top: 20px;
        }
        
        .cart-item {
            display: flex;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid rgba(93, 78, 63, 0.2);
        }
        
        .cart-item img {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 8px;
            margin-right: 15px;
        }
        
        .cart-item-details {
            flex: 1;
        }
        
        .cart-item-title {
            font-weight: bold;
            color: #5d4e3f;
            margin-bottom: 5px;
        }
        
        .cart-item-price {
            color: #5d4e3f;
            opacity: 0.8;
        }
        
        /* Profile Panel Styling */
        .profile-info {
            text-align: center;
            margin-top: 30px;
        }
        
        .profile-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: #5d4e3f;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
        }
        
        .member-tier {
            color: #5d4e3f;
            font-size: 1.2rem;
            font-weight: bold;
            margin-bottom: 10px;
        }
        
        .profile-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
            margin-top: 30px;
            text-align: center;
        }
        
        .stat-item {
            background: rgba(255, 255, 255, 0.2);
            padding: 15px;
            border-radius: 8px;
        }
        
        .stat-number {
            font-size: 1.5rem;
            font-weight: bold;
            color: #5d4e3f;
        }
        
        .stat-label {
            font-size: 0.8rem;
            color: #5d4e3f;
            opacity: 0.8;
        }

        /* --- FIXED CHATBOT UI --- */
        .chat-wrap { 
            position: fixed; 
            bottom: 30px; 
            right: 30px; 
            z-index: 9999;
        }

        .chat-box {
            position: fixed; 
            bottom: 120px; 
            right: 30px;
            width: 320px; 
            height: 480px;
            background: white; 
            border-radius: 24px;
            display: none; 
            flex-direction: column;
            box-shadow: 0 15px 40px rgba(93, 78, 63, 0.3);
            overflow: hidden; 
            animation: slideUp 0.4s ease;
            z-index: 9998;
        }

        @keyframes slideUp { from { opacity:0; transform: translateY(20px); } to { opacity:1; transform: translateY(0); } }

        .chat-header { 
            background: #5d4e3f; 
            color: white; 
            padding: 20px; 
            font-weight: bold; 
            text-align: center; 
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .close-chat {
            cursor: pointer;
            font-size: 20px;
            opacity: 0.8;
            transition: opacity 0.3s;
        }

        .close-chat:hover {
            opacity: 1;
        }

        .chat-main { 
            flex: 1; 
            background: #f9f7f4; 
            padding: 15px; 
            overflow-y: auto; 
            display: flex; 
            flex-direction: column; 
            gap: 10px; 
        }
        .bot-msg { 
            background: #f5f0e6; 
            color: #5d4e3f; 
            padding: 10px 14px; 
            border-radius: 15px; 
            font-size: 0.85rem; 
            max-width: 85%; 
            align-self: flex-start; 
            animation: fadeIn 0.3s ease;
        }
        .user-msg { 
            background: #5d4e3f; 
            color: white; 
            padding: 10px 14px; 
            border-radius: 15px; 
            font-size: 0.85rem; 
            max-width: 85%; 
            align-self: flex-end;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .chat-menu { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 6px; 
            padding: 10px; 
            background: white; 
            border-top: 1px solid #e0ddd6; 
        }
        .menu-item { 
            border: 1px solid #bfa37e; 
            color: #5d4e3f; 
            padding: 8px; 
            border-radius: 10px; 
            font-size: 0.7rem; 
            text-align: center; 
            cursor: pointer; 
            font-weight: bold; 
            transition: all 0.3s;
        }
        .menu-item:hover { 
            background: #5d4e3f; 
            color: white; 
            transform: scale(1.05);
        }
        .robot-btn { 
            background: none; 
            border: none; 
            cursor: pointer; 
            animation: float 3s ease-in-out infinite;
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 9999;
        }

        @keyframes float { 
            0%, 100% { transform: translateY(0); } 
            50% { transform: translateY(-12px); } 
        }

        /* --- FOOTER --- */
        .aura-footer {
            background: #5d4e3f;
            padding: 60px 10% 20px;
            color: white;
            width: 100%;
            position: relative;
            z-index: 1;
        }

        .footer-grid { 
            display: grid; 
            grid-template-columns: 1fr 1fr 2fr; 
            gap: 40px; 
            margin-bottom: 40px; 
        }

        .footer-col h3 { 
            font-size: 1rem; 
            margin-bottom: 20px; 
            text-transform: uppercase; 
            font-weight: 400;
            letter-spacing: 1px;
        }
        
        .footer-col p { 
            font-size: 0.85rem; 
            margin-bottom: 8px; 
            opacity: 0.9; 
            cursor: pointer; 
            transition: opacity 0.3s;
        }
        
        .footer-col p:hover {
            opacity: 1;
        }
        
        .about-col p { 
            line-height: 1.6; 
            text-align: justify;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.2);
            padding-top: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .bottom-socials {
            display: flex;
            gap: 15px;
            align-items: center;
        }
        
        .bottom-socials img { 
            width: 24px; 
            height: 24px;
            opacity: 0.8; 
            cursor: pointer;
            transition: opacity 0.3s, transform 0.3s;
            filter: brightness(0) invert(1);
        }
        
        .bottom-socials img:hover {
            opacity: 1;
            transform: translateY(-3px);
        }
        
        .footer-bottom span {
            font-size: 0.9rem;
            opacity: 0.9;
        }

        /* تحسينات روابط الفوتر */
        .footer-col p a {
            color: white; 
            text-decoration: none;
            position: relative;
            display: inline-block;
            padding-bottom: 3px;
            transition: all 0.3s ease;
        }

        /* خط تحت روابط Main Menu عند التمرير فقط */
        .footer-col:first-child p a:hover::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: #bfa37e;
            transform: scaleX(1);
            transition: transform 0.3s ease;
        }

        /* خط تحت روابط Collection عند التمرير فقط */
        .footer-col:nth-child(2) p {
            position: relative;
            display: inline-block;
            padding-bottom: 3px;
        }

        .footer-col:nth-child(2) p:hover::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: #bfa37e;
            transform: scaleX(1);
            transition: transform 0.3s ease;
        }

        /* رابط Learn More About Us */
        .footer-col.about-col a {
            color: white;
            text-decoration: none !important;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .footer-col.about-col a:hover {
            color: #bfa37e;
            padding-left: 5px;
        }

        /* Responsive Design */
        @media (max-width: 900px) {
            .product-container {
                grid-template-columns: 1fr;
            }
            .product-images {
                position: relative;
                top: 0;
            }
            
            .footer-grid {
                grid-template-columns: 1fr;
                gap: 30px;
            }
            
            .chat-box {
                width: 280px;
                height: 420px;
                right: 20px;
                bottom: 110px;
            }
        }

        @media (max-width: 850px) { 
            .nav-menu { display: none; } 
            .aura-footer {
                padding: 40px 5% 20px;
            }
        }

        @media (max-width: 768px) {
            .footer-bottom {
                flex-direction: column;
                gap: 20px;
                text-align: center;
            }
            
            nav {
                padding: 15px 20px;
            }
            
            .product-container {
                margin: 100px auto 40px;
                gap: 30px;
            }
        }

        @media (max-width: 600px) {
            .robot-btn img {
                width: 70px;
            }
            .chat-box {
                width: 250px;
                height: 380px;
                right: 15px;
                bottom: 100px;
            }
            
            .product-title {
                font-size: 2.2rem;
            }
            
            .product-price {
                font-size: 1.8rem;
            }
        }

        @media (max-width: 480px) {
            .footer-col h3 {
                font-size: 0.9rem;
            }
            
            .footer-col p {
                font-size: 0.8rem;
            }
            .robot-btn {
                bottom: 20px;
                right: 20px;
            }
        }
    </style>
</head>
<body>

    <div id="viewport">
        
        <!-- Cart Side Panel -->
        <div id="cartPanel" class="side-panel">
            <div class="panel-header">CART <span style="cursor:pointer" onclick="togglePanel('cartPanel')">✕</span></div>
            <div class="cart-items">
                <div class="cart-item">
                    <!-- صورة ساعة Rolex الرجالية -->
                    <img src="rolex_men.jpg" alt="Rolex Men's Watch">
                    <div class="cart-item-details">
                        <div class="cart-item-title">Rolex Submariner Men's Watch</div>
                        <div class="cart-item-price">120,000 IQD</div>
                    </div>
                    <div class="cart-quantity">1</div>
                </div>
            </div>
            <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid rgba(93, 78, 63, 0.3);">
                <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
                    <span style="color: #5d4e3f;">Subtotal</span>
                    <span style="color: #5d4e3f; font-weight: bold;">120,000 IQD</span>
                </div>
                <button onclick="checkout()" style="width: 100%; padding: 15px; background: #5d4e3f; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;">
                    PROCEED TO CHECKOUT
                </button>
            </div>
        </div>

        <!-- Profile Side Panel -->
        <div id="profilePanel" class="side-panel">
            <div class="panel-header">PROFILE <span style="cursor:pointer" onclick="togglePanel('profilePanel')">✕</span></div>
            <div class="profile-info">
                <div class="profile-avatar">JW</div>
                <div class="member-tier">VIP MEMBER</div>
                <div style="color: #5d4e3f; opacity: 0.8;">John Walker</div>
                <div style="color: #5d4e3f; font-size: 0.9rem; margin-top: 5px;">john.walker@email.com</div>
            </div>
            
            <div class="profile-stats">
                <div class="stat-item">
                    <div class="stat-number">3</div>
                    <div class="stat-label">Orders</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">12</div>
                    <div class="stat-label">Wishlist</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">VIP</div>
                    <div class="stat-label">Tier</div>
                </div>
            </div>
            
            <div style="margin-top: 40px;">
                <div style="color: #5d4e3f; font-weight: bold; margin-bottom: 15px;">Account Settings</div>
                <div style="color: #5d4e3f; padding: 10px 0; border-bottom: 1px solid rgba(93, 78, 63, 0.2); cursor: pointer;">Edit Profile</div>
                <div style="color: #5d4e3f; padding: 10px 0; border-bottom: 1px solid rgba(93, 78, 63, 0.2); cursor: pointer;">Order History</div>
                <div style="color: #5d4e3f; padding: 10px 0; border-bottom: 1px solid rgba(93, 78, 63, 0.2); cursor: pointer;">Shipping Address</div>
                <div style="color: #5d4e3f; padding: 10px 0; border-bottom: 1px solid rgba(93, 78, 63, 0.2); cursor: pointer;">Payment Methods</div>
            </div>
        </div>

        <!-- Navigation -->
        <nav id="mainNav">
            <div class="brand-container">
                <img src="Aura logo.png" class="brand-logo-img" onclick="goToHome()">
            </div>
            <div class="nav-menu">
                <a href="home.html" class="nav-link">Home</a>
                <a href="ourCollection.html" class="nav-link">Our Collection</a>
                <a href="aboutUs.html" class="nav-link">About Us</a>
                <a href="contact.html" class="nav-link">Contact</a>
            </div>
            <div class="nav-actions">
                <button class="icon-btn active" id="lapBtn" onclick="setMode('laptop')">
                    <img src="https://img.icons8.com/material-outlined/48/ffffff/monitor.png">
                </button>
                <button class="icon-btn" id="phnBtn" onclick="setMode('phone')">
                    <img src="https://img.icons8.com/material-outlined/48/ffffff/iphone.png">
                </button>
                <button class="icon-btn" onclick="togglePanel('cartPanel')">
                    <img src="https://img.icons8.com/material-outlined/48/ffffff/shopping-cart.png">
                </button>
                <button class="icon-btn" onclick="togglePanel('profilePanel')">
                    <img src="https://img.icons8.com/material-outlined/48/ffffff/user-male-circle.png">
                </button>
            </div>
        </nav>

        <!-- Product Section -->
        <div class="product-container">
            <div class="product-images">
                <div class="main-image">
                    <!-- صورة ساعة Rolex الرجالية الرئيسية -->
                    <img id="mainProductImage" src="rolex_men.jpg" alt="Rolex Submariner Men's Watch">
                </div>
            </div>

            <div class="product-details">
                <div class="brand-name">ROLEX</div>
                <h1 class="product-title">Submariner Date</h1>
                <div class="product-price">120,000 IQD</div>

                <p style="color: #5d4e3f; line-height: 1.6; margin-bottom: 20px; text-align: justify;">
                    The Rolex Submariner is an iconic diving watch that has become a symbol of luxury and adventure. This men's model features a robust 41mm Oystersteel case, black Cerachrom bezel, and a sophisticated black dial with luminescent markers. Designed for professional divers, it offers exceptional water resistance up to 300 meters.
                </p>

                <div class="specs-container">
                    <div class="spec-row">
                        <span class="spec-label">Case Size</span>
                        <span class="spec-value">41mm</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Movement</span>
                        <span class="spec-value">Rolex Caliber 3235 Automatic</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Water Resistance</span>
                        <span class="spec-value">300 meters / 1000 feet</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Bracelet Material</span>
                        <span class="spec-value">Oystersteel with Oysterlock clasp</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Case Material</span>
                        <span class="spec-value">Oystersteel with Cerachrom bezel</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Dial Color</span>
                        <span class="spec-value">Black with Chromalight display</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Power Reserve</span>
                        <span class="spec-value">Approximately 70 hours</span>
                    </div>
                    <div class="spec-row">
                        <span class="spec-label">Functions</span>
                        <span class="spec-value">Date, Rotating Bezel, Luminescence</span>
                    </div>
                </div>

                <div class="quantity-selector">
                    <button class="quantity-btn" onclick="updateQuantity(-1)">  -</button>
                    <div id="quantity" style="font-size: 1.5rem; font-weight: bold; color: #5d4e3f;">1</div>
                    <button class="quantity-btn" onclick="updateQuantity(1)">+</button>
                </div>

                <div class="action-buttons">
                    <button class="add-to-cart-btn" onclick="addToCart()">ADD TO CART</button>
                    <button class="buy-now-btn" onclick="buyNow()">BUY NOW</button>
                </div>
                
                <div style="margin-top: 30px; color: #5d4e3f; font-size: 0.9rem;">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                        <span>✔</span> <span>Free worldwide insured shipping</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                        <span>✔</span> <span>5-year international Rolex warranty</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                        <span>✔</span> <span>Complete documentation & original box</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span>✔</span> <span>Complimentary professional sizing service</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Section -->
        <footer class="aura-footer">
            <div class="footer-grid">
                <!-- Main Menu Column -->
                <div class="footer-col">
                    <h3>MAIN MENU</h3>
                    <p><a href="home.html" style="color: white; text-decoration: none;">Home</a></p>
                    <p><a href="ourCollection.html" style="color: white; text-decoration: none;">Our Collection</a></p>
                    <p><a href="aboutUs.html" style="color: white; text-decoration: none;">About Us</a></p>
                    <p><a href="contact.html" style="color: white; text-decoration: none;">Contact</a></p>
                </div>
                
                <!-- Collection Column -->
                <div class="footer-col">
                    <h3>COLLECTION</h3>
                    <p onclick="scrollToSection('men-section')">Men's Collection</p><br>
                    <p onclick="scrollToSection('women-section')">Women's Collection</p>
                   
                </div>
                
                <!-- About Column -->
                <div class="footer-col about-col">
                    <h3>ABOUT AURA WATCHES</h3>
                    <p>At Aura Watches, we believe a timepiece is more than just a tool, it is a reflection of your personality and a witness to your life's best moments. Our mission is to blend timeless elegance with modern precision.</p>
                    <p style="margin-top: 15px;">
                        <a href="aboutUs.html" style="color: white; text-decoration: none; font-weight: bold;">
                            Learn More About Us →
                        </a>
                    </p>
                </div>
            </div>
            
            <!-- Bottom Bar -->
            <div class="footer-bottom">
                <span>Stay in touch</span>
                <div class="bottom-socials">
                    <img src="https://img.icons8.com/ios/50/ffffff/instagram-new.png" alt="Instagram" onclick="openSocial('instagram')">
                    <img src="https://img.icons8.com/ios/50/ffffff/snapchat.png" alt="Snapchat" onclick="openSocial('snapchat')">
                    <img src="https://img.icons8.com/ios/50/ffffff/tiktok.png" alt="TikTok" onclick="openSocial('tiktok')">
                </div>
            </div>
        </footer>

        <!-- FIXED Chatbot Section -->
        <div class="chat-wrap">
            <div class="chat-box" id="chatWindow">
                <div class="chat-header">
                    AURA CONCIERGE
                    <span class="close-chat" onclick="toggleChat()">✕</span>
                </div>
                <div class="chat-main" id="msgArea">
                    <div class="bot-msg">Welcome to AURA Watches! I'm here to help you with this legendary Rolex Submariner men's timepiece. What would you like to know about this professional diving watch?</div>
                </div>
                <div class="chat-menu">
                    <div class="menu-item" onclick="ask('Product Details')">📋 DETAILS</div>
                    <div class="menu-item" onclick="ask('Water Resistance')">🌊 WATER RESISTANCE</div>
                    <div class="menu-item" onclick="ask('Warranty')">🛡️ WARRANTY</div>
                    <div class="menu-item" onclick="ask('Authentication')">🔍 AUTHENTICITY</div>
                </div>
            </div>
            <button class="robot-btn" onclick="toggleChat()">
                <img src="chatbot.png" width="100" alt="AI Assistant">
            </button>
        </div>
    </div>

    <script>
        // Navigation scroll effect
        window.onscroll = function() {
            const nav = document.getElementById('mainNav');
            const productSection = document.querySelector('.product-container');
            if (productSection && window.pageYOffset >= productSection.offsetTop - 100) {
                nav.classList.add('scrolled-nav', 'light-nav');
            } else {
                nav.classList.remove('scrolled-nav', 'light-nav');
            }
            
            // AI button always visible
            const robotBtn = document.querySelector('.robot-btn');
            if (robotBtn) {
                robotBtn.style.position = 'fixed';
                robotBtn.style.bottom = '30px';
                robotBtn.style.right = '30px';
            }
            
            // التأكد من بقاء لون الروابط قهوائياً حتى بعد التمرير
            const navLinks = document.querySelectorAll('.nav-menu a');
            navLinks.forEach(link => {
                link.style.color = '#5d4e3f';
            });
        };

        // Toggle side panels
        function togglePanel(id) {
            document.querySelectorAll('.side-panel').forEach(p => { 
                if(p.id !== id) p.classList.remove('open'); 
            });
            document.getElementById(id).classList.toggle('open');
        }

        // Switch between laptop and phone view
        function setMode(mode) {
            const vp = document.getElementById('viewport');
            const lBtn = document.getElementById('lapBtn');
            const pBtn = document.getElementById('phnBtn');
            if (mode === 'phone') {
                vp.classList.add('phone-view');
                pBtn.classList.add('active'); 
                lBtn.classList.remove('active');
            } else {
                vp.classList.remove('phone-view');
                lBtn.classList.add('active'); 
                pBtn.classList.remove('active');
            }
        }

        // Chatbot functions
        let chatOpen = false;
        function toggleChat() {
            const win = document.getElementById('chatWindow');
            chatOpen = !chatOpen;
            
            if (chatOpen) {
                win.style.display = 'flex';
                // Auto scroll to bottom
                setTimeout(() => {
                    const msgArea = document.getElementById('msgArea');
                    msgArea.scrollTop = msgArea.scrollHeight;
                }, 100);
            } else {
                win.style.display = 'none';
            }
        }

        function ask(topic) {
            const area = document.getElementById('msgArea');
            let response = "";
            
            if(topic === 'Product Details') response = "The Rolex Submariner Date features a 41mm Oystersteel case, Rolex Caliber 3235 automatic movement with 70-hour power reserve, 300m water resistance, and a black Cerachrom bezel. It's a professional diving watch with date function.";
            if(topic === 'Water Resistance') response = "This Rolex Submariner is water resistant to 300 meters (1000 feet). It's suitable for professional diving and features a screw-down crown and case back for maximum waterproof protection.";
            if(topic === 'Warranty') response = "This Rolex comes with a 5-year international warranty and includes complete documentation. The warranty covers manufacturing defects and includes worldwide service coverage at authorized Rolex service centers.";
            if(topic === 'Authentication') response = "Every Rolex from AURA Watches is 100% genuine with complete documentation including warranty card, certificate of authenticity, serial numbers, and original Rolex packaging.";

            area.innerHTML += `<div class="user-msg">${topic}</div>`;
            setTimeout(() => {
                area.innerHTML += `<div class="bot-msg">${response}</div>`;
                area.scrollTop = area.scrollHeight;
            }, 600);
        }

        // Product quantity functions
        let quantity = 1;
        function updateQuantity(change) {
            quantity = Math.max(1, quantity + change);
            document.getElementById('quantity').textContent = quantity;
        }

        function addToCart() { 
            const product = {
                name: "Rolex Submariner Date Men's Watch",
                price: 120000,
                quantity: quantity,
                image: "rolex_men.jpg"
            };
            
            alert(`Added ${quantity} × Rolex Submariner Date to your cart!`);
            
            // Update cart panel
            const cartItems = document.querySelector('.cart-items');
            const cartItem = document.createElement('div');
            cartItem.className = 'cart-item';
            cartItem.innerHTML = `
                <img src="rolex_men.jpg" alt="Rolex Men's Watch">
                <div class="cart-item-details">
                    <div class="cart-item-title">Rolex Submariner Men's Watch</div>
                    <div class="cart-item-price">120,000 IQD</div>
                </div>
                <div class="cart-quantity">${quantity}</div>
            `;
            
            // Update subtotal
            const subtotal = 120000 * quantity;
            document.querySelector('.cart-items').innerHTML = cartItem.outerHTML;
            document.querySelector('.cart-item-details + div').innerHTML = `<span style="color: #5d4e3f; font-weight: bold;">${subtotal.toLocaleString()} IQD</span>`;
            
            // Open cart panel
            togglePanel('cartPanel');
        }
        
        function buyNow() { 
            alert("Proceeding to checkout with " + quantity + " Rolex Submariner watch(es)!");
        }
        
        function checkout() {
            alert("Redirecting to secure checkout for your Rolex purchase...");
        }
        
        function goToHome() { 
            window.location.href = 'home.html'; 
        }
        
        // Social media functions
        function openSocial(platform) {
            const urls = {
                instagram: 'https://instagram.com/aurawatches',
                snapchat: 'https://snapchat.com/add/aurawatches',
                tiktok: 'https://tiktok.com/@aurawatches'
            };
            
            alert(`In a complete website, this would open ${platform} in a new tab`);
        }
        
        function scrollToSection(sectionType) {
            alert(`In the complete website, this would scroll to the ${sectionType}`);
        }

        // Ensure AI button stays fixed on page load
        document.addEventListener('DOMContentLoaded', function() {
            const robotBtn = document.querySelector('.robot-btn');
            if (robotBtn) {
                robotBtn.style.position = 'fixed';
                robotBtn.style.bottom = '30px';
                robotBtn.style.right = '30px';
                robotBtn.style.zIndex = '9999';
            }
            
            // Initialize phone/laptop view
            setMode('laptop');
            
            // Highlight current page in navigation
            const currentPage = window.location.pathname.split('/').pop();
            const navLinks = document.querySelectorAll('.nav-menu a');
            navLinks.forEach(link => {
                if (link.getAttribute('href') === currentPage) {
                    link.classList.add('active');
                }
                
                // التأكد من أن جميع الروابط باللون القهوائي
                link.style.color = '#5d4e3f';
            });
            
            // تطبيق اللون القهوائي على جميع روابط النافبار
            setTimeout(() => {
                const allNavLinks = document.querySelectorAll('#mainNav .nav-menu a');
                allNavLinks.forEach(link => {
                    link.style.color = '#5d4e3f';
                    link.style.setProperty('color', '#5d4e3f', 'important');
                });
            }, 100);
        });
    </script>
</body>
</html>